<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Instagram Clone</title>

<style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:Arial, sans-serif;
}

body{
  background:#fafafa;
  color:#111;
}

header{
  position:sticky;
  top:0;
  background:white;
  border-bottom:1px solid #ddd;
  padding:15px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  z-index:10;
}

.logo{
  font-size:28px;
  font-weight:bold;
  font-family:cursive;
}

.search{
  background:#efefef;
  border:none;
  padding:10px;
  border-radius:8px;
  width:180px;
}

.container{
  max-width:600px;
  margin:auto;
}

/* Stories */
.stories{
  display:flex;
  gap:15px;
  overflow-x:auto;
  padding:15px;
  background:white;
  margin-bottom:15px;
}

.story{
  text-align:center;
  font-size:12px;
}

.story img{
  width:65px;
  height:65px;
  border-radius:50%;
  padding:3px;
  border:3px solid #e1306c;
  object-fit:cover;
}

/* Post */
.post{
  background:white;
  border:1px solid #ddd;
  margin-bottom:20px;
  border-radius:5px;
  overflow:hidden;
}

.post-header{
  display:flex;
  align-items:center;
  padding:12px;
}

.profile{
  width:40px;
  height:40px;
  border-radius:50%;
  margin-right:10px;
  object-fit:cover;
}

.username{
  font-weight:bold;
  flex:1;
}

.more{
  font-size:22px;
}

.post-image{
  width:100%;
  height:350px;
  object-fit:cover;
}
